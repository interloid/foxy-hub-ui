NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SITE_NAME=Name of the site

NEXT_PUBLIC_SITE_DESCRIPTION=Description about the site 

# Optional: Twitter/X handle for twitter:site card metadata, e.g. @vercel.
NEXT_PUBLIC_TWITTER_HANDLE=

# Client-side Sentry DSN (same project as SENTRY_DSN above, safe to expose).
NEXT_PUBLIC_SENTRY_DSN=

# --- Error monitoring (Sentry) ---
# Optional. Leave blank to disable Sentry entirely (no-op in dev).
# Server-side DSN, used in instrumentation.ts.
SENTRY_DSN=
# Org/project slugs + auth token, used only at build time to upload source maps.
# Not needed for local dev.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Vercel deployment environment (development, preview, or production)
VERCEL_ENV=

# Node.js runtime environment (development, production, or test)
NODE_ENV=

# ---------------------------------------------------------------------------
# Supabase (decisions.md D016)
# Only the URL and the ANON key are public. The anon key is safe to expose —
# RLS is what authorises, and every table has it enabled.
#
# The SERVICE-ROLE key is NOT here and must never be. It bypasses RLS entirely
# and belongs only to the edge functions, set with `supabase secrets set`.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVICE ROLE — bypasses RLS completely. Server-only, never NEXT_PUBLIC_, never in a client
# bundle (lib/supabase/admin.ts is guarded by `import "server-only"`). Used for exactly one
# thing: auth.admin.inviteUserByEmail, the only API that will send an invitation email.
SUPABASE_SERVICE_ROLE_KEY=